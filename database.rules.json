{
  "rules": {
    "events": {
      "$eventId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('playerCode').val() === $eventId && newData.parent().parent().child('organizerSecret').child($eventId).exists() && newData.parent().parent().child('organizerClaims').child($eventId).child(auth.uid).val() === newData.parent().parent().child('organizerSecret').child($eventId).val()) || (data.exists() && root.child('organizerSecret').child($eventId).exists() && root.child('organizerClaims').child($eventId).child(auth.uid).val() === root.child('organizerSecret').child($eventId).val()))",
        "rounds": {
          "$round": {
            "results": {
              "$court": {
                ".write": "auth != null && $round.matches(/^[0-2]$/) && root.child('events').child($eventId).child('courts').child($court).exists()",
                ".validate": "newData.hasChildren(['team1Score', 'team2Score', 'timestamp'])",
                "team1Score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99 && newData.val() % 1 === 0" },
                "team2Score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99 && newData.val() % 1 === 0" },
                "timestamp": { ".validate": "newData.isString() && newData.val().length <= 40" },
                "$other": { ".validate": false }
              }
            }
          }
        }
      }
    },

    "organizerCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.isString() && newData.parent().parent().child('organizerSecret').child(newData.val()).val() === $code && !root.child('events').child(newData.val()).exists()) || (data.exists() && !newData.exists() && root.child('organizerSecret').child(data.val()).val() === $code && root.child('organizerClaims').child(data.val()).child(auth.uid).val() === $code))"
      }
    },

    "organizerSecret": {
      "$eventId": {
        ".read": "auth != null && data.exists() && root.child('organizerClaims').child($eventId).child(auth.uid).val() === data.val()",
        ".write": "auth != null && ((!data.exists() && newData.isString() && !root.child('events').child($eventId).exists() && newData.parent().parent().child('events').child($eventId).child('playerCode').val() === $eventId && newData.parent().parent().child('organizerCodes').child(newData.val()).val() === $eventId) || (data.exists() && !newData.exists() && root.child('organizerClaims').child($eventId).child(auth.uid).val() === data.val() && !newData.parent().parent().child('events').child($eventId).exists()))"
      }
    },

    "organizerClaims": {
      "$eventId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (newData.isString() && newData.val() === newData.parent().parent().parent().child('organizerSecret').child($eventId).val()))"
        }
      }
    },

    "rankings": {
      "$rid": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('id').val() === $rid && newData.parent().parent().child('rankingSecret').child($rid).exists() && newData.parent().parent().child('rankingClaims').child($rid).child(auth.uid).val() === newData.parent().parent().child('rankingSecret').child($rid).val()) || (data.exists() && root.child('rankingSecret').child($rid).exists() && root.child('rankingClaims').child($rid).child(auth.uid).val() === root.child('rankingSecret').child($rid).val()))",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "players": {
          "$pid": {
            ".validate": "newData.hasChild('name')",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            }
          }
        },
        "aliases": {
          "$alias": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        },
        "imports": {
          "$iid": {
            ".validate": "newData.hasChildren(['name', 'date', 'source'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "source": {
              ".validate": "newData.isString() && newData.val().matches(/^(kisa|games|levels|placement)$/)"
            }
          }
        }
      }
    },

    "rankingCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.isString() && newData.parent().parent().child('rankingSecret').child(newData.val()).val() === $code && !root.child('rankings').child(newData.val()).exists()) || (data.exists() && !newData.exists() && root.child('rankingSecret').child(data.val()).val() === $code && root.child('rankingClaims').child(data.val()).child(auth.uid).val() === $code))"
      }
    },

    "rankingSecret": {
      "$rid": {
        ".read": "auth != null && data.exists() && root.child('rankingClaims').child($rid).child(auth.uid).val() === data.val()",
        ".write": "auth != null && ((!data.exists() && newData.isString() && !root.child('rankings').child($rid).exists() && newData.parent().parent().child('rankings').child($rid).child('id').val() === $rid && newData.parent().parent().child('rankingCodes').child(newData.val()).val() === $rid) || (data.exists() && !newData.exists() && root.child('rankingClaims').child($rid).child(auth.uid).val() === data.val() && !newData.parent().parent().child('rankings').child($rid).exists()))"
      }
    },

    "rankingClaims": {
      "$rid": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (newData.isString() && newData.val() === newData.parent().parent().parent().child('rankingSecret').child($rid).val()))"
        }
      }
    }
  }
}
